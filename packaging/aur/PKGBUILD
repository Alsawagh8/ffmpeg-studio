# Maintainer: Alsawagh8 <https://github.com>
pkgname=ffmpeg-studio
pkgver=0.4.4
pkgrel=1
pkgdesc="Modern, fast native GUI for FFmpeg built with Rust, GTK4 & Libadwaita"
arch=('x86_64')
url="https://github.com/ffmpeg-studio"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'ffmpeg')
makedepends=('cargo' 'git')
source=("$pkgname-$pkgver.tar.gz::https://github.com/ffmpeg-studio/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/ffmpeg-studio-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$srcdir/ffmpeg-studio-$pkgver"
    install -Dm755 "target/release/ffmpeg-gui" "$pkgdir/usr/bin/ffmpeg-gui"
}
